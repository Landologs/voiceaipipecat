OPENAI_API_KEY=
GEMINI_API_KEY=
STT_PROVIDER=
LLM_PROVIDER=
TTS_PROVIDER=
STT_MODEL=
LLM_MODEL=
TTS_MODEL=
TTS_VOICE=
TTS_SPEED=1.15
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# All `demo-*` commands always use the isolated demo/ folder.
BUSINESS_CONFIG_PATH=
AUDIO_INPUT_DEVICE_INDEX=
AUDIO_OUTPUT_DEVICE_INDEX=
LOG_TRANSCRIPTS=
RECORD_CALL_AUDIO=

# Twilio inbound calls. TWILIO_PUBLIC_URL can stay blank behind ngrok because
# forwarded HTTPS/WSS host headers are used automatically.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PUBLIC_URL=
TELEPHONY_HOST=127.0.0.1
TELEPHONY_PORT=8000
NGROK_AUTHTOKEN=

# Future integrations. No real Google Calendar or WhatsApp calls are made yet.
GOOGLE_CALENDAR_CREDENTIALS_FILE=
GOOGLE_CALENDAR_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
